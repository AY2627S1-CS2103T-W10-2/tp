@startuml

start

:User enters `find` command;

if () then ([Prefix-like token is present])
    :Validate and normalise clues;
    :Use structured search\n(AND semantics);
else ([Prefix-like token is absent])
    :Use keyword search\n(OR semantics);
endif

:Filter unarchived contacts;

if () then ([Contacts matched])
    :Display matching contacts;
    :Report number of persons listed;
else ([No contacts matched])
    :Return "No persons found!";
endif

stop

@enduml
